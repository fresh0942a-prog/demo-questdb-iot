{
  "uid": "sensores-iot",
  "title": "Monitoreo de sensores IoT (QuestDB)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperatura por sensor (°C)",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "questdb-pg" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 30 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, sensor_id, avg(temperatura) AS temperatura FROM sensores WHERE $__timeFilter(ts) SAMPLE BY 5s"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Última temperatura por sensor",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "postgres", "uid": "questdb-pg" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 15,
          "max": 45,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 28 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sensor_id, temperatura FROM sensores LATEST ON ts PARTITION BY sensor_id"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Humedad relativa (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "postgres", "uid": "questdb-pg" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, ubicacion, avg(humedad) AS humedad FROM sensores WHERE $__timeFilter(ts) SAMPLE BY 10s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Vibración (g)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "postgres", "uid": "questdb-pg" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, sensor_id, max(vibracion) AS vibracion FROM sensores WHERE $__timeFilter(ts) SAMPLE BY 5s"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Alertas: temperatura > 30 °C",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "postgres", "uid": "questdb-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts, sensor_id, ubicacion, temperatura FROM sensores WHERE temperatura > 30 AND $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
        }
      ]
    }
  ]
}
